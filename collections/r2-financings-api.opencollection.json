            "url": "https://gateway-dev.r2capital.co:443/v2/financings/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "uuid formatted ID."
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Show a financing by its id."
        },
        {
          "info": {
